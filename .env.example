# Google Gemini API key (required) — https://aistudio.google.com/app/apikey
GEMINI_API=

# SerpAPI key (required for !google) — https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Optional model overrides. Defaults use Google's "-latest" aliases and
# automatically fall back to lighter models when one is overloaded.
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# GEMINI_PRO_MODEL=gemini-3.1-pro-preview
# GEMINI_MODERATION_MODEL=gemini-3.1-flash-lite

# SQLite database file (default: data/bot.db)
# DB_PATH=data/bot.db
